# Токен бота MAX (выдаётся в кабинете разработчика ботов MAX)
MAX_BOT_TOKEN=

# Строка подключения к БД, используется приложением (bot/admin).
# Хост "db" — имя сервиса Postgres в docker-compose.
# Логин/пароль/имя базы должны совпадать со значениями ниже.
DATABASE_URL=postgresql+asyncpg://xlsx_bot:changeme@db:5432/xlsx_bot

# Эти три переменные использует контейнер Postgres при первом запуске
# для создания пользователя/базы — держите в синхронизации с DATABASE_URL выше.
POSTGRES_USER=xlsx_bot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=xlsx_bot

# Админка (SQLAdmin)
ADMIN_SECRET_KEY=changeme-generate-a-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
